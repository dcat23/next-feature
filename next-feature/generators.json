{
  "generators": {
    "init": {
      "factory": "./src/generators/init/init",
      "schema": "./src/generators/init/schema.json",
      "description": "init generator"
    },
    "dotenv": {
      "factory": "./src/generators/misc/dotenv/dotenv",
      "schema": "./src/generators/misc/dotenv/schema.json",
      "description": "dotenv generator"
    },
    "feature": {
      "factory": "./src/generators/project/feature/feature",
      "schema": "./src/generators/project/feature/schema.json",
      "description": "feature generator"
    },
    "preset": {
      "factory": "./src/generators/preset/preset",
      "schema": "./src/generators/preset/schema.json",
      "description": "preset generator",
      "x-use-standalone-layout": true
    },
    "component": {
      "factory": "./src/generators/code/component/component",
      "schema": "./src/generators/code/component/schema.json",
      "description": "component generator"
    },
    "store": {
      "factory": "./src/generators/code/store/store",
      "schema": "./src/generators/code/store/schema.json",
      "description": "store generator"
    },
    "copy-deps": {
      "factory": "./src/generators/tool/copy-deps/copy-deps",
      "schema": "./src/generators/tool/copy-deps/schema.json",
      "description": "copy-deps generator"
    },
    "application": {
      "factory": "./src/generators/project/application/application",
      "schema": "./src/generators/project/application/schema.json",
      "description": "application generator"
    },
    "declaration": {
      "factory": "./src/generators/code/declaration/declaration",
      "schema": "./src/generators/code/declaration/schema.json",
      "description": "declaration generator"
    },
    "action": {
      "factory": "./src/generators/code/action/action",
      "schema": "./src/generators/code/action/schema.json",
      "description": "action generator"
    },
    "hook": {
      "factory": "./src/generators/code/hook/hook",
      "schema": "./src/generators/code/hook/schema.json",
      "description": "hook generator"
    },
    "client-config": {
      "factory": "./src/generators/misc/client-config/client-config",
      "schema": "./src/generators/misc/client-config/schema.json",
      "description": "client config generator"
    }
  }
}

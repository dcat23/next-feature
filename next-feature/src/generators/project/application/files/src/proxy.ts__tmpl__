<% if (useAuth) { %>import { NextResponse } from 'next/server';
import { auth } from '@feature/auth/server';

// Reads the session and runs the jwt callback, so an expired access token is
// refreshed (and the cookie saved) before the request reaches server
// components. The proxy runs on the Node.js runtime, so it can use the auth
// feature's server entry.
export const proxy = auth((request) => {
  // request.auth is the session (null when signed out). Route protection
  // goes here, e.g.:
  // if (!request.auth && request.nextUrl.pathname.startsWith('/dashboard')) {
  //   return NextResponse.redirect(new URL('/auth', request.nextUrl));
  // }
  // Still check auth() in server actions, route handlers and data access:
  // the proxy only covers the routes the matcher below includes.
  return NextResponse.next();
});
<% } else { %>import { NextResponse, type NextRequest } from 'next/server';

// eslint-disable-next-line @typescript-eslint/no-unused-vars -- passthrough until you need the request
export function proxy(request: NextRequest) {
  return NextResponse.next();
}
<% } %>
export const config = {
  matcher: [
    // Skip Next.js internals and all static files, unless found in search params
    '/((?!_next|[^?]*\\.(?:html?|css|js(?!on)|jpe?g|webp|png|gif|svg|ttf|woff2?|ico|csv|docx?|xlsx?|zip|webmanifest)).*)',
    // Always run for API routes
    '/(api)(.*)',
  ],
};

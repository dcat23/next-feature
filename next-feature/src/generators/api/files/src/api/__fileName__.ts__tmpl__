'use server';


<% if (hasRequestBody) { %>import { z } from "zod";<% } %>
import type {
  <%= typeImports %>
} from '../types';
import { <%= constantName %> } from '../constants'
import api, {
  type BackendResponse,
  handleError
} from '<%= axiosImportPath %>';

interface BackendRequestOptions {

}

export async function <%= methodName %>(
  options?: BackendRequestOptions
): Promise<BackendResponse<<%= className %>>> {
  try {
    const params: URLSearchParams = new URLSearchParams();
    const endpoint = `/<%= endpoint %>?${params.toString()}`;
    <% if (hasRequestBody) { %>
    const body: <%= className %>Request = {
      ...options
    }

    const parsed = z
      .object({})
      .safeParse(body);

    if (!parsed.success) {
      return handleError(parsed.error, <%= constantName %>);
    }
    <% } %>
    const { data } = await api.<%= httpMethod %><<%= className %>Response>(endpoint<% if (hasRequestBody) { %>, parsed.data<% } %>);

    return { data };
  } catch (error) {
    return handleError<<%= className %>>(error, <%= constantName %>);
  }
}

{
  "$schema": "https://json-schema.org/schema",
  "$id": "CopyDeps",
  "title": "Copy Dependencies",
  "description": "Copy dependencies from a package json to the root project",
  "type": "object",

  "properties": {
    "directory": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "Path to the package.json"
    },
    "replaceExisting": {
      "type": "boolean",
      "description": "Replace existing dependencies?",
      "default": true,
      "alias": "r"
    }
  },
  "required": ["directory"]
}

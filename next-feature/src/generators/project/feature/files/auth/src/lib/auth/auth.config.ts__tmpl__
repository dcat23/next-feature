import type { NextAuthConfig } from 'next-auth';
import { authorized, jwt, redirect, session, signIn } from './callbacks';

// Shared NextAuth options; providers are added in ./index.ts. Server code only:
// the callbacks reach backend.ts.
// Cookies keep the Auth.js defaults (__Host-/__Secure- prefixes, `secure` over
// https). Outside Vercel, set AUTH_URL and AUTH_TRUST_HOST=true.
export const authConfig: NextAuthConfig = {
  pages: {
    signIn: `/auth`,
    error: '/auth', // Error code passed in query string as ?error=
  },
  callbacks: {
    authorized,
    signIn,
    jwt,
    session,
    redirect,
  },
  session: {
    strategy: 'jwt',
    // Keep this at most your backend's refresh token lifetime
    maxAge: 30 * 24 * 60 * 60,
  },
  providers: [],
};

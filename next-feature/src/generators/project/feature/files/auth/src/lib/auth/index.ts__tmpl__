import NextAuth, { NextAuthResult } from 'next-auth';
import CredentialsProvider from 'next-auth/providers/credentials';
import GitHub from 'next-auth/providers/github';
import Google from 'next-auth/providers/google';
import { authConfig } from './auth.config';
import { credentialsSchema, login } from './backend';
import { runAuthFlow, toTokenFields } from './tokens';

const nextAuth: NextAuthResult = NextAuth({
  ...authConfig,
  providers: [
    // Zero-config OAuth providers: read AUTH_<PROVIDER>_ID / AUTH_<PROVIDER>_SECRET
    // from the environment. Their sign-ins are exchanged with your backend by
    // exchangeOAuth() (backend.ts) and refused until it's implemented. Remove
    // any providers you don't need.
    GitHub,
    Google,
    CredentialsProvider({
      name: 'Credentials',
      credentials: {
        email: { label: 'Email', type: 'email' },
        password: { label: 'Password', type: 'password' },
      },
      // Return null for any rejected sign-in, without saying why (e.g. whether
      // the email exists). For a specific, non-sensitive reason, throw a
      // subclass of CredentialsSignin with a `code` (shown in the URL).
      async authorize(credentials, request) {
        const parsed = credentialsSchema.safeParse(credentials);
        if (!parsed.success) return null;

        const ip = request.headers.get('x-forwarded-for')?.split(',')[0]?.trim();
        const result = await runAuthFlow('login', () => login(parsed.data, { ip }));
        if (!result) return null;

        return {
          ...result.user,
          ...toTokenFields(result),
        };
      },
    }),
  ],
});

export const auth: NextAuthResult['auth'] = nextAuth.auth;
export const handlers: NextAuthResult['handlers'] = nextAuth.handlers;
export const signIn: NextAuthResult['signIn'] = nextAuth.signIn;
export const signOut: NextAuthResult['signOut'] = nextAuth.signOut;

{
  "$schema": "https://json-schema.org/schema",
  "$id": "Types",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name for the type interface",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the name of this interface?"
    },
    "projectName": {
      "type": "string",
      "description": "The name for the features generator plugin",
      "default": "features"
    },
    "directory": {
      "type": "string",
      "description": "The directory in the project",
      "default": "lib"
    }
  },
  "required": ["name"]
}

import { z } from 'zod';

/**
 * Calls to your backend's auth endpoints. Replace the stubs below: until
 * they're implemented, every sign-in is refused (login() and exchangeOAuth()
 * return null).
 *
 * Only the server runs this code (authorize() and the jwt callback), and
 * nothing it returns reaches the browser except what the session callback
 * exposes.
 *
 * The examples use an ApiClient from this feature's lib/config/client.ts,
 * whose base URL is <%= apiKeyName %>:
 *
 *   npx nx g next-feature:client-config -p <%= name %>
 *
 * Don't call getAccessToken() from here, directly or through a client's
 * onAuthenticated: these calls obtain the tokens, so the session cookie
 * doesn't hold them yet. It throws when called from here (see runAuthFlow()
 * in tokens.ts); without that it would deadlock on its own refresh, or, when
 * someone signs in while signed in as another user, return that user's
 * token. Use the tokens these calls receive instead (see login()).
 */

/** What the sign-in form posts; validated by authorize() before login() */
export const credentialsSchema = z.object({
  email: z.string().email(),
  password: z.string().min(1),
});

export type BackendCredentials = z.infer<typeof credentialsSchema>;

export interface BackendTokens {
  accessToken: string;
  /** Omitted when the backend doesn't rotate refresh tokens */
  refreshToken?: string;
  /** Access token lifetime in seconds */
  expiresIn: number;
}

export interface BackendSession extends BackendTokens {
  user: {
    id: string;
    role: string;
    name?: string | null;
    email?: string | null;
  };
}

/**
 * An OAuth/OIDC sign-in for the backend to verify itself. Never trust the
 * provider profile alone: send the provider's credential and let the backend
 * check it.
 */
export interface OAuthExchange {
  /** Provider id, e.g. 'google', 'github' */
  provider: string;
  /** The user's id at the provider */
  providerAccountId: string;
  /** OIDC providers (Google): verify the signature, issuer and audience */
  idToken?: string;
  /** OAuth-only providers (GitHub): fetch the identity from the provider's API with it */
  accessToken?: string;
}

export interface LoginContext {
  /** Client IP, forwarded so the backend can rate-limit login attempts */
  ip?: string;
}

/**
 * Exchange credentials for a backend session. Return null for invalid
 * credentials (wrong password, unknown email, ...); throw only for
 * unexpected failures.
 *
 * @example
 * import { ApiError } from '@next-feature/client';
 * import api from '../config/client';
 *
 * try {
 *   const session = await api.post<BackendSession>('/auth/login', credentials, {
 *     headers: context.ip ? { 'X-Forwarded-For': context.ip } : undefined,
 *   });
 *   // Calls to other services during sign-in use the token just received:
 *   // const profile = await users.get<Profile>('/me', {
 *   //   headers: { Authorization: `Bearer ${session.accessToken}` },
 *   // });
 *   return session;
 * } catch (error) {
 *   if (ApiError.of(error).isUnauthorized) return null;
 *   throw error;
 * }
 */
// eslint-disable-next-line @typescript-eslint/no-unused-vars -- stub: replace with your backend call
export async function login(credentials: BackendCredentials, context: LoginContext): Promise<BackendSession | null> {
  return null;
}

/**
 * Exchange an OAuth/OIDC sign-in for a backend session. Return null to refuse
 * the sign-in (the user lands on the error page with ?error=AccessDenied);
 * throwing refuses it too.
 *
 * The backend decides which account the identity belongs to: link or create
 * accounts by an existing provider link or a verified email only (Google's
 * `email_verified`; GitHub's verified primary email from /user/emails).
 * Linking on an unverified email lets anyone who registers that address at
 * the provider take over the account.
 *
 * @example
 * import { ApiError } from '@next-feature/client';
 * import api from '../config/client';
 *
 * try {
 *   return await api.post<BackendSession>('/auth/oauth', input);
 * } catch (error) {
 *   if (ApiError.of(error).isUnauthorized) return null;
 *   throw error;
 * }
 */
export async function exchangeOAuth(input: OAuthExchange): Promise<BackendSession | null> {
  console.warn(
    `[auth] ${input.provider} sign-in refused: implement exchangeOAuth() in lib/auth/backend.ts, ` +
      'or remove the provider from lib/auth/index.ts'
  );
  return null;
}

/**
 * Exchange a refresh token for new tokens. Throw when the backend refuses
 * it: the user is then signed out (session `error: 'RefreshTokenError'`).
 * ApiClient already throws an ApiError for any error response.
 *
 * @example
 * import api from '../config/client';
 *
 * return api.post<BackendTokens>('/auth/refresh', { refreshToken });
 */
// eslint-disable-next-line @typescript-eslint/no-unused-vars -- stub: replace with your backend call
export async function refresh(refreshToken: string): Promise<BackendTokens> {
  throw new Error('Token refresh is not implemented: see lib/auth/backend.ts');
}

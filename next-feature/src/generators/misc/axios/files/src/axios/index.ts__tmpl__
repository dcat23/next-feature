import { BACKEND_API_URL } from '../config';
<% if (useInterceptor) { %>import { AxiosInterceptor } from './interceptor';
<% } else { %>import axios from 'axios';<% } %>

<% if (useInterceptor) { %>
export const <%= apiName %> = (new AxiosInterceptor(BACKEND_API_URL)).instance;
<% } else { %>
export const <%= apiName %> = axios.create({
  baseURL: BACKEND_API_URL,
  headers: {
    'Content-Type': 'application/json',
  },
});<% } %>

export * from "./types";
export * from "./error";

export default <%= apiName %>;

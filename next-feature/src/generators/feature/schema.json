{
  "$schema": "https://json-schema.org/schema",
  "$id": "Feature",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the project features will be added to.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?"
    },
    "directory": {
      "type": "string",
      "description": "Where to create this project",
      "default": "."
    },
    "srcPath": {
      "type": "string",
      "description": "The directory where features files will generated to",
      "default": "src"
    }
  },
  "required": ["name"]
}

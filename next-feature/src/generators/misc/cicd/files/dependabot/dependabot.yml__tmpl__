# Weekly dependency updates, generated by next-feature:cicd
version: 2
updates:
  - package-ecosystem: <%- ecosystem %>
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 10
    # Update Nx with `nx migrate latest`, which also migrates the workspace's code and configuration
    ignore:
      - dependency-name: nx
      - dependency-name: '@nx/*'
    groups:
      minor-and-patch:
        update-types: [minor, patch]

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    groups:
      github-actions:
        patterns: ['*']

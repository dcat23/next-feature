'use server';

import type {
  <%= typeImports %>
} from '../types';
import api from '@feature/base/lib/axios';
import { handleError } from '@/feature/base/lib/axios/error';
import type { BackendResponse } from '@feature/base/lib/axios/types';

interface BackendRequestBody {

}

export async function <%= methodName %>(
  body?: BackendRequestBody
): Promise<BackendResponse<<%= className %>>> {
  const params: URLSearchParams = new URLSearchParams();
  const endpoint = `/api/<%= endpoint %>?${params.toString()}`;

  <% if (hasRequestBody) { %>
  const body: <%= className %>Request = {
      ...options
  }
  <% } %>

  try {
    const { data } = await api.<%= httpMethod %><<%= className %>>(endpoint<% if (hasRequestBody) { %>, body<% } %>);

    return { data };
  } catch (error: any) {
    return handleError<<%= className %>>(error);
  }
}

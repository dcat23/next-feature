{
  "$schema": "https://json-schema.org/schema",
  "$id": "Store",
  "title": "Store generator",
  "description": "Generate store files using Zustand or React Context",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the name for this api method?"
    },
    "package": {
      "type": "string",
      "description": "The directory within the source",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "default": "store"
    },
    "directory": {
      "type": "string",
      "description": "The directory of the features plugin",
      "default": "features",
      "alias": "d"
    },
    "projectName": {
      "type": "string",
      "description": "The package where the generated files will go",
      "default": "features",
      "alias": "p"
    },
    "useContext": {
      "type": "boolean",
      "description": "Will generated as React Context",
      "default": false,
      "alias": "c"
    }
  },
  "required": ["name"]
}

{
  "$schema": "https://json-schema.org/schema",
  "$id": "Api",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the name for this api method?"
    },
    "package": {
      "type": "string",
      "description": "The package within the feature plugin",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "default": "lib"
    },
    "directory": {
      "type": "string",
      "description": "The directory of the features plugin"
    },
    "projectName": {
      "type": "string",
      "description": "The package where the generated files will go"
    },
    "useTypes": {
      "type": "boolean",
      "description": "Generate type files",
      "default": true
    }
  },
  "required": ["name"]
}

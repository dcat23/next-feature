{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "<%= importPath %>/components",
    "utils": "<%= importPath %>/lib/utils",
    "ui": "<%= importPath %>/components",
    "lib": "<%= importPath %>/lib",
    "hooks": "<%= importPath %>/hooks"
  },
  "iconLibrary": "lucide"
}

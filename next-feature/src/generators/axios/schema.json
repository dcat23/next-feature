{
  "$schema": "https://json-schema.org/schema",
  "$id": "Axios",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the feature project",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What project should this packaged be added to?",
    },
    "appProjectName": {
      "type": "string",
      "description": "App project to add env files too",
      "alias": "a"
    },
    "projectName": {
      "type": "string",
      "description": "The source project name",
      "alias": "p"
    },
    "skipFiles": {
      "type": "boolean",
      "description": "Skip generating axios files.",
      "alias": "f"
    }
  },
  "required": ["name"]
}

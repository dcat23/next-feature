'use server';

import { z } from "zod";
import type {
  <%= typeImports %>
} from '../types';
import api from '<%= axiosImportPath %>';
import { handleError } from '<%= axiosImportPath %>/error';
import type { BackendResponse } from '<%= axiosImportPath %>/types';

interface BackendRequestOptions {

}

export async function <%= methodName %>(
  options?: BackendRequestOptions
): Promise<BackendResponse<<%= className %>>> {
  try {
    const params: URLSearchParams = new URLSearchParams();
    const endpoint = `/api/<%= endpoint %>?${params.toString()}`;
    <% if (hasRequestBody) { %>
    const body: <%= className %>Request = {
      ...options
    }

    const parsed = z
      .object({})
      .safeParse(body);

    if (!parsed.success) {
      return handleError(parsed.error);
    }
    <% } %>
    const { data } = await api.<%= httpMethod %><<%= className %>>(endpoint<% if (hasRequestBody) { %>, parsed.data<% } %>);

    return { data };
  } catch (error) {
    return handleError<<%= className %>>(error);
  }
}

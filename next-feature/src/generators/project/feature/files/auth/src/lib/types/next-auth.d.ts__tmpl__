import type { DefaultSession, DefaultUser, Session, User } from 'next-auth';
import type { DefaultJWT, JWT } from 'next-auth/jwt';

// Replace with a union of your application's role names, e.g. 'admin' | 'user'
type Role = string;

/** Set on the session when the backend refused to refresh the tokens: sign in again */
export type AuthError = 'RefreshTokenError';

declare module 'next-auth' {
  /**
   * What the browser sees (useSession(), /api/auth/session).
   * Never add backend tokens here: read them on the server with getAccessToken().
   */
  interface Session extends DefaultSession {
    // Listed explicitly: DefaultSession['user'] is the augmented User below,
    // which carries the backend tokens
    user: {
      id: string;
      role: Role;
      name?: string | null;
      email?: string | null;
      image?: string | null;
    };
    error?: AuthError;
  }

  /** Returned by authorize() or the signIn exchange; only seen by the jwt callback at sign-in */
  interface User extends DefaultUser {
    role?: Role;
    accessToken?: string;
    refreshToken?: string;
    /** Epoch ms */
    accessTokenExpires?: number;
  }
}

declare module 'next-auth/jwt' {
  /** Stored encrypted in the session cookie; server-side only */
  interface JWT extends DefaultJWT {
    role?: Role;
    accessToken?: string;
    refreshToken?: string;
    /** Epoch ms */
    accessTokenExpires?: number;
    error?: AuthError;
  }
}

export type { JWT, Session, User };

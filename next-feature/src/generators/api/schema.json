{
  "$schema": "https://json-schema.org/schema",
  "$id": "Api",
  "title": "Api Generator",
  "description": "Generate server action function for calls to external APIs",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the name for this api method?"
    },
    "package": {
      "type": "string",
      "description": "The package within the feature plugin",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "default": "lib"
    },
    "directory": {
      "type": "string",
      "description": "The directory of the features plugin",
      "alias": "d"
    },
    "projectName": {
      "type": "string",
      "description": "The package where the generated files will go",
      "alias": "p"
    },
    "useTypes": {
      "type": "boolean",
      "description": "Generate type files",
      "default": true,
      "alias": "t"
    },
    "useConstant": {
      "type": "boolean",
      "description": "Generate default data",
      "default": true,
      "alias": "c"
    }
  },
  "required": ["name"]
}

{
  "$schema": "https://json-schema.org/schema",
  "$id": "Component",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?"
    },
    "package": {
      "type": "string",
      "description": "The directory within the source",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "default": "components"
    },
    "directory": {
      "type": "string",
      "description": "The directory of the features plugin",
      "alias": "d"
    },
    "projectName": {
      "type": "string",
      "description": "The package where the generated files will go",
      "alias": "p"
    },
    "componentType": {
      "type": "string",
      "description": "The type of component to generate",
      "alias": "t",
      "default": "component",
      "enum": ["component", "page", "layout", "modal", "card", "form", "provider"],
      "x-prompt": {
        "message": "Which component type would you like to generate?",
        "type": "list",
        "items": [
          { "value": "component", "label": "Component - Basic client component" },
          { "value": "modal", "label": "Modal - Dialog/modal component" },
          { "value": "card", "label": "Card - Card container component" },
          { "value": "form", "label": "Form - Form with state management" },
          { "value": "provider", "label": "Provider - Context provider component" },
          { "value": "page", "label": "Page - Next.js page component" },
          { "value": "layout", "label": "Layout - Next.js layout component" }
        ]
      }
    }
  },
  "required": ["name"]
}

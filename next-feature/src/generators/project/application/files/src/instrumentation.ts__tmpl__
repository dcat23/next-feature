<% if (!skipLogging) { %>
export async function register() {
  // pino only runs on Node.js: keep it out of the edge instrumentation bundle
  if (process.env.NEXT_RUNTIME === 'nodejs') {
    const [{ registerPino }, { pinoOptions }] = await Promise.all([
      import('@next-feature/logging/server'),
      import('./lib/config/logging'),
    ]);
    await registerPino(pinoOptions);
  }
}
<% } else { %>
export async function register() {
  // Logging was skipped for this app (skipLogging: true).
}
<% } %>

name: <%- ciWorkflow %>

# Lints, tests and builds the projects affected by a pull request, or by the
# commits pushed to <%- mainBranch %> since its last successful run (nrwl/nx-set-shas).
# Generated by next-feature:cicd; the deploy workflows wait for this one by name.
on:
  pull_request:
  push:
    branches: [<%- mainBranch %>]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.ref }}
  # Superseded pull request runs are cancelled; every <%- mainBranch %> push finishes,
  # since deployments follow its successful runs
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read
  actions: read # nx-set-shas looks up the last successful run

env:
  NX_DAEMON: false
  NX_TUI: false
<% if (noCloud) { %>  NX_NO_CLOUD: true
<% } %>
jobs:
  main:
    runs-on: ubuntu-latest
    steps:
      - uses: <%- actions.checkout %>
        with:
          fetch-depth: 0 # nx affected compares against the base commit

<%- setupSteps %>

      - uses: <%- actions.nxSetShas %><% if (mainBranch !== 'main') { %>
        with:
          main-branch-name: <%- mainBranch %><% } %>

      - run: <%- nx %> affected -t <%- ciTargets %>
<% if (e2e) { %>
  e2e:
    needs: main
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: <%- actions.checkout %>
        with:
          fetch-depth: 0

<%- setupSteps %>

      - uses: <%- actions.nxSetShas %><% if (mainBranch !== 'main') { %>
        with:
          main-branch-name: <%- mainBranch %><% } %>

      # Playwright projects need their browsers: add
      #   - run: <%- nx.replace(/ nx$/, '') %> playwright install --with-deps
      - run: <%- nx %> affected -t e2e
<% } %>
